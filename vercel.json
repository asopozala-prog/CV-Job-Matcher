{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "nextjs"
    },
    "backend": {
      "root": ".",
      "framework": "fastapi",
      "bindings": [
        {
          "type": "service",
          "service": "pdf",
          "format": "url",
          "env": "PDF_SERVICE_URL"
        }
      ]
    },
    "pdf": {
      "root": "pdf-service",
      "framework": "express"
    }
  },
  "rewrites": [
    {
      "source": "/api/backend/:path*",
      "destination": {
        "service": "backend",
        "path": "/:path*"
      }
    },
    {
      "source": "/:path*",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
